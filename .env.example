# FloodGuard — variáveis de ambiente.
# Copie para .env e ajuste se necessário. Nunca commitar o .env real.

# +psycopg (não postgresql:// puro): o driver instalado é psycopg 3, não
# psycopg2 — o scheme da URL precisa dizer isso ao SQLAlchemy.
DATABASE_URL=postgresql+psycopg://floodguard:floodguard@postgis:5432/floodguard
POSTGRES_USER=floodguard
POSTGRES_PASSWORD=floodguard
POSTGRES_DB=floodguard

API_PORT=8000
WEB_PORT=5173

# true = telemetria e comunicação (UniMesh/LoRa) simuladas por software.
# Nenhum modo "false" existe ainda — hardware real é item de roadmap.
SIMULATION_MODE=true
